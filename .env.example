# Copy to .env and fill in. .env is gitignored — never commit the real key.
#
# Get a key at https://app.upload-post.com -> API Keys.
# The social accounts must also be connected under Manage Users; the key alone
# does not grant access to any platform.
UPLOAD_POST_API_KEY=

# The profile username shown in Upload-Post -> Manage Users.
# This is the value sent as the API `user` field.
UPLOAD_POST_USER=
